{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jason-weirather/omeify/schemas/crop_report.schema.json",
  "title": "Crop export report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "input_path",
    "source_series",
    "output_path",
    "shatter",
    "clip",
    "outputs",
    "channel_mapping",
    "crop_mode",
    "mask_background",
    "fill_value",
    "padding",
    "pad_outside"
  ],
  "properties": {
    "schema": {
      "const": "omeify.crop/6"
    },
    "input_path": {
      "type": "string",
      "minLength": 1
    },
    "source_series": {
      "type": "integer",
      "minimum": 0
    },
    "source_group": {
      "type": ["string", "null"]
    },
    "source_z": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "source_t": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "output_path": {
      "type": "string",
      "minLength": 1
    },
    "shatter": {
      "enum": [
        null,
        "by_index",
        "by_name"
      ]
    },
    "clip": {
      "type": "boolean"
    },
    "channel_mapping": {
      "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/crop_channel_mapping"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "regions",
          "write_report"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "regions": {
            "type": "array",
            "items": {
              "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/crop_region"
            },
            "minItems": 1
          },
          "write_report": {
            "oneOf": [
              {
                "$ref": "https://github.com/jason-weirather/omeify/schemas/multi_series_report.schema.json"
              },
              {
                "$ref": "https://github.com/jason-weirather/omeify/schemas/zarr_collection_report.schema.json"
              }
            ]
          }
        }
      },
      "minItems": 1
    },
    "crop_mode": {
      "enum": [
        "bounding_rectangle",
        "polygon_mask"
      ]
    },
    "mask_background": {
      "enum": [
        "auto",
        "black",
        "white",
        "keep"
      ]
    },
    "fill_value": {
      "type": "number"
    },
    "padding": {
      "type": "integer",
      "minimum": 0
    },
    "pad_outside": {
      "type": "boolean"
    }
  }
}
