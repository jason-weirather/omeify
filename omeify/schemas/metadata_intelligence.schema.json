{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jason-weirather/omeify/schemas/metadata_intelligence.schema.json",
  "title": "omeify metadata intelligence report",
  "description": "Optional advisory inspection result with locally collected metadata evidence. TIFF directory locations identify storage; OME Image indices in XML paths are not asserted to be TIFF series indices. Not a deidentification or pixel quality assessment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "prompt_version",
    "source",
    "allowed_scopes",
    "coverage",
    "records",
    "summary"
  ],
  "properties": {
    "schema": {
      "const": "omeify.schemas/metadata_intelligence.schema.json"
    },
    "schema_version": {
      "const": "1.0"
    },
    "prompt_version": {
      "enum": [
        "1.0",
        "2.0"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "model",
        "scope",
        "organization"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "institutional",
            "local",
            "external"
          ]
        },
        "organization": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "allowed_scopes": {
      "type": "array",
      "items": {
        "enum": [
          "institutional",
          "local",
          "external"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "minItems": 1
    },
    "summary": {
      "$ref": "#/$defs/summary"
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "quote"
      ],
      "properties": {
        "record_id": {
          "$ref": "#/$defs/record_id"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "evidence"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/statement_text"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1,
          "maxItems": 8
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "label",
        "value",
        "interpretation",
        "evidence"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/finding_category"
        },
        "label": {
          "$ref": "#/$defs/finding_label"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "interpretation": {
          "$ref": "#/$defs/finding_interpretation"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1,
          "maxItems": 8
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overview",
        "findings",
        "cautions"
      ],
      "properties": {
        "overview": {
          "$ref": "#/$defs/statement"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          },
          "maxItems": 80
        },
        "cautions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/statement"
          },
          "maxItems": 16
        }
      },
      "description": "Advisory model interpretation with metadata values and evidence quotations. Prompt 1.0 supplied model-copied substrings checked locally; prompt 2.0 selects records and omeify copies their complete values locally. Record references and exact quotations do not prove that the prose is supported or scientifically correct."
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "locations",
        "value",
        "truncated",
        "occurrences"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/record_id"
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 8
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "truncated": {
          "type": "boolean"
        },
        "occurrences": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ifds_scanned",
        "tags_scanned",
        "records_available",
        "records_included",
        "records_truncated",
        "metadata_chars",
        "max_metadata_chars",
        "scan_limited",
        "omitted",
        "warnings"
      ],
      "properties": {
        "ifds_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "tags_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "records_available": {
          "type": "integer",
          "minimum": 0
        },
        "records_included": {
          "type": "integer",
          "minimum": 0
        },
        "records_truncated": {
          "type": "integer",
          "minimum": 0
        },
        "metadata_chars": {
          "type": "integer",
          "minimum": 0
        },
        "max_metadata_chars": {
          "type": "integer",
          "minimum": 4096
        },
        "scan_limited": {
          "type": "boolean"
        },
        "omitted": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "binary_or_large_arrays",
            "oversized_tags",
            "unreadable_tags",
            "embedded_binary_or_unsafe_xml"
          ],
          "properties": {
            "binary_or_large_arrays": {
              "type": "integer",
              "minimum": 0
            },
            "oversized_tags": {
              "type": "integer",
              "minimum": 0
            },
            "unreadable_tags": {
              "type": "integer",
              "minimum": 0
            },
            "embedded_binary_or_unsafe_xml": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "records",
        "coverage"
      ],
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          }
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        }
      }
    },
    "record_id": {
      "type": "string",
      "pattern": "^m[1-9][0-9]*$"
    },
    "statement_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "finding_category": {
      "type": "string",
      "enum": [
        "date",
        "identifier",
        "path",
        "acquisition",
        "channel",
        "calibration",
        "processing",
        "other"
      ]
    },
    "finding_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "finding_interpretation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "model_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "record_ids"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/statement_text"
        },
        "record_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_id"
          },
          "minItems": 1,
          "maxItems": 8
        }
      },
      "description": "Advisory model prose with references to supplied records. Omeify copies evidence quotations locally; the model does not reproduce them."
    },
    "model_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "category",
        "label",
        "interpretation"
      ],
      "properties": {
        "record_id": {
          "$ref": "#/$defs/record_id"
        },
        "category": {
          "$ref": "#/$defs/finding_category"
        },
        "label": {
          "$ref": "#/$defs/finding_label"
        },
        "interpretation": {
          "$ref": "#/$defs/finding_interpretation"
        }
      },
      "description": "Select and interpret one supplied metadata record. Its exact value and evidence quotation are copied by omeify, never authored by the model. Use overview/cautions for statements supported by multiple records."
    },
    "model_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overview",
        "findings",
        "cautions"
      ],
      "properties": {
        "overview": {
          "$ref": "#/$defs/model_statement"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model_finding"
          },
          "maxItems": 80
        },
        "cautions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model_statement"
          },
          "maxItems": 16
        }
      },
      "description": "Prompt protocol 2.0: select records and supply advisory interpretation. The request binds record_id to an enum of IDs actually supplied. This is not the final report summary, which includes locally copied values and quotations."
    }
  }
}
