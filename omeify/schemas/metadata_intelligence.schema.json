{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jason-weirather/omeify/schemas/metadata_intelligence.schema.json",
  "title": "omeify metadata intelligence report",
  "description": "Optional advisory inspection result with locally collected metadata evidence. TIFF directory locations identify storage; OME Image indices in XML paths are not asserted to be TIFF series indices. Not a deidentification or pixel quality assessment. Schema 1.1 permits explicitly computed calibration records and their coverage counts; prompt 2.1 explains reciprocal TIFF density and OME pixel length conventions. Schema 1.2 adds a focused question/answer alternative to the broad summary, with locally copied values and evidence and metadata-only inspection statistics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "prompt_version",
    "source",
    "allowed_scopes",
    "coverage",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "omeify.schemas/metadata_intelligence.schema.json"
    },
    "schema_version": {
      "enum": [
        "1.0",
        "1.1",
        "1.2"
      ]
    },
    "prompt_version": {
      "enum": [
        "1.0",
        "2.0",
        "2.1",
        "3.0"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "model",
        "scope",
        "organization"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "institutional",
            "local",
            "external"
          ]
        },
        "organization": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "allowed_scopes": {
      "type": "array",
      "items": {
        "enum": [
          "institutional",
          "local",
          "external"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "minItems": 1
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "question": {
      "$ref": "#/$defs/question"
    },
    "answer": {
      "$ref": "#/$defs/answer"
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "quote"
      ],
      "properties": {
        "record_id": {
          "$ref": "#/$defs/record_id"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "evidence"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/statement_text"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1,
          "maxItems": 8
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "label",
        "value",
        "interpretation",
        "evidence"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/finding_category"
        },
        "label": {
          "$ref": "#/$defs/finding_label"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "interpretation": {
          "$ref": "#/$defs/finding_interpretation"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1,
          "maxItems": 8
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overview",
        "findings",
        "cautions"
      ],
      "properties": {
        "overview": {
          "$ref": "#/$defs/statement"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          },
          "maxItems": 80
        },
        "cautions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/statement"
          },
          "maxItems": 16
        }
      },
      "description": "Advisory model interpretation with metadata values and evidence quotations. Prompt 1.0 supplied model-copied substrings checked locally; prompt 2.0 selects records and omeify copies their complete values locally. Record references and exact quotations do not prove that the prose is supported or scientifically correct."
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "locations",
        "value",
        "truncated",
        "occurrences"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/record_id"
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 8
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "truncated": {
          "type": "boolean"
        },
        "occurrences": {
          "type": "integer",
          "minimum": 1
        },
        "origin": {
          "enum": [
            "metadata",
            "computed"
          ],
          "description": "Absent means source metadata, as in schema 1.0. Computed evidence is generated locally by omeify from calibration checks or allowlisted file/layout statistics, not copied TIFF text."
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ifds_scanned",
        "tags_scanned",
        "records_available",
        "records_included",
        "records_truncated",
        "metadata_chars",
        "max_metadata_chars",
        "scan_limited",
        "omitted",
        "warnings"
      ],
      "properties": {
        "ifds_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "tags_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "records_available": {
          "type": "integer",
          "minimum": 0
        },
        "records_included": {
          "type": "integer",
          "minimum": 0
        },
        "records_truncated": {
          "type": "integer",
          "minimum": 0
        },
        "metadata_chars": {
          "type": "integer",
          "minimum": 0
        },
        "max_metadata_chars": {
          "type": "integer",
          "minimum": 4096
        },
        "scan_limited": {
          "type": "boolean"
        },
        "omitted": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "binary_or_large_arrays",
            "oversized_tags",
            "unreadable_tags",
            "embedded_binary_or_unsafe_xml"
          ],
          "properties": {
            "binary_or_large_arrays": {
              "type": "integer",
              "minimum": 0
            },
            "oversized_tags": {
              "type": "integer",
              "minimum": 0
            },
            "unreadable_tags": {
              "type": "integer",
              "minimum": 0
            },
            "embedded_binary_or_unsafe_xml": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "computed_records_available": {
          "type": "integer",
          "minimum": 0
        },
        "computed_records_included": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "records",
        "coverage"
      ],
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          }
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        }
      }
    },
    "record_id": {
      "type": "string",
      "pattern": "^m[1-9][0-9]*$"
    },
    "statement_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "finding_category": {
      "type": "string",
      "enum": [
        "date",
        "identifier",
        "path",
        "acquisition",
        "channel",
        "calibration",
        "processing",
        "other"
      ]
    },
    "finding_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "finding_interpretation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "model_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "record_ids"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/statement_text"
        },
        "record_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_id"
          },
          "minItems": 1,
          "maxItems": 8
        }
      },
      "description": "Advisory model prose with references to supplied records. Omeify copies evidence quotations locally; the model does not reproduce them."
    },
    "model_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "category",
        "label",
        "interpretation"
      ],
      "properties": {
        "record_id": {
          "$ref": "#/$defs/record_id"
        },
        "category": {
          "$ref": "#/$defs/finding_category"
        },
        "label": {
          "$ref": "#/$defs/finding_label"
        },
        "interpretation": {
          "$ref": "#/$defs/finding_interpretation"
        }
      },
      "description": "Select and interpret one supplied metadata record. Its exact value and evidence quotation are copied by omeify, never authored by the model. Use overview/cautions for statements supported by multiple records."
    },
    "model_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overview",
        "findings",
        "cautions"
      ],
      "properties": {
        "overview": {
          "$ref": "#/$defs/model_statement"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model_finding"
          },
          "maxItems": 80
        },
        "cautions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model_statement"
          },
          "maxItems": 16
        }
      },
      "description": "Prompt protocol 2.0: select records and supply advisory interpretation. The request binds record_id to an enum of IDs actually supplied. This is not the final report summary, which includes locally copied values and quotations."
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S",
      "description": "User question, retained exactly and transmitted as user input, not system instructions."
    },
    "answer_status": {
      "type": "string",
      "enum": [
        "answered",
        "partial",
        "unavailable"
      ]
    },
    "answer_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "evidence"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 0,
          "maxItems": 128
        }
      }
    },
    "model_answer_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "record_ids"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "record_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_id"
          },
          "minItems": 0,
          "maxItems": 128
        }
      },
      "description": "One plain-text answer paragraph or caveat with supplied record references. No references are needed for an explicit statement that evidence is unavailable."
    },
    "answer_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "value",
        "evidence"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/finding_label"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1,
          "maxItems": 1
        }
      },
      "description": "One selected value, copied exactly by omeify; label is advisory model text."
    },
    "model_answer_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "record_id"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/finding_label"
        },
        "record_id": {
          "$ref": "#/$defs/record_id"
        }
      },
      "description": "Select a record for a requested list or exact value. Do not transcribe its value."
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "paragraphs",
        "items",
        "cautions"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/answer_status"
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/answer_statement"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/answer_item"
          },
          "maxItems": 256
        },
        "cautions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/answer_statement"
          },
          "maxItems": 16
        }
      },
      "description": "Focused, advisory answer to one user question, not a general metadata summary. Paragraphs and labels are model prose. Exact selected values and quotations are copied locally. Status does not establish correctness or completeness."
    },
    "model_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "paragraphs",
        "items",
        "cautions"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/answer_status"
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model_answer_statement"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model_answer_item"
          },
          "maxItems": 256
        },
        "cautions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model_answer_statement"
          },
          "maxItems": 16
        }
      },
      "description": "Focused, advisory answer to one user question, not a general metadata summary. Paragraphs and labels are model prose. Exact selected values and quotations are copied locally. Status does not establish correctness or completeness."
    }
  },
  "oneOf": [
    {
      "required": [
        "summary"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "question"
            ]
          },
          {
            "required": [
              "answer"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "question",
        "answer"
      ],
      "not": {
        "required": [
          "summary"
        ]
      },
      "properties": {
        "schema_version": {
          "const": "1.2"
        },
        "prompt_version": {
          "const": "3.0"
        }
      }
    }
  ]
}
