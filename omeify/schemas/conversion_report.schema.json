{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jason-weirather/omeify/schemas/conversion_report.schema.json",
  "title": "Conversion report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ome",
    "output_file",
    "image",
    "pyramid",
    "verification",
    "miti_header",
    "input_file",
    "options",
    "conversion_stats",
    "versions"
  ],
  "properties": {
    "schema": {
      "const": "omeify.convert/2"
    },
    "ome": {
      "oneOf": [
        {
          "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/ome"
        },
        {
          "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/zarr_ome"
        }
      ]
    },
    "output_file": {
      "oneOf": [
        {
          "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/output_file"
        },
        {
          "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/zarr_output_file"
        }
      ]
    },
    "image": {
      "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/image"
    },
    "pyramid": {
      "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/pyramid"
    },
    "verification": {
      "oneOf": [
        {
          "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/verification"
        },
        {
          "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/zarr_verification"
        }
      ]
    },
    "miti_header": {
      "oneOf": [
        {
          "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/miti"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_file": {
      "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/input_file"
    },
    "options": {
      "oneOf": [
        {
          "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/conversion_options"
        },
        {
          "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/zarr_conversion_options"
        }
      ]
    },
    "conversion_stats": {
      "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/stats"
    },
    "versions": {
      "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/versions"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "output_file": {
            "properties": {
              "type_description": {
                "const": "Pyramidal OME-Zarr"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "ome": {
            "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/zarr_ome"
          },
          "options": {
            "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/zarr_conversion_options"
          },
          "verification": {
            "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/zarr_verification"
          },
          "miti_header": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "ome": {
            "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/ome"
          },
          "options": {
            "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/conversion_options"
          },
          "verification": {
            "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/verification"
          },
          "miti_header": {
            "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/miti"
          }
        }
      }
    }
  ]
}
