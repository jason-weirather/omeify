{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jason-weirather/omeify/schemas/mutation_report.schema.json",
  "title": "Explicit numeric mutation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "ome",
    "output_file",
    "image",
    "pyramid",
    "verification",
    "miti_header",
    "input_file",
    "options",
    "mutation_stats",
    "versions"
  ],
  "properties": {
    "schema": {
      "const": "omeify.mutate/1"
    },
    "operation": {
      "enum": [
        "dtype",
        "float32_precision"
      ]
    },
    "ome": {
      "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/ome"
    },
    "output_file": {
      "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/output_file"
    },
    "image": {
      "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/image"
    },
    "pyramid": {
      "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/pyramid"
    },
    "verification": {
      "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/verification"
    },
    "miti_header": {
      "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/miti"
    },
    "input_file": {
      "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/input_file"
    },
    "options": {
      "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/mutation_options"
    },
    "mutation_stats": {
      "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/stats"
    },
    "versions": {
      "$ref": "https://github.com/jason-weirather/omeify/schemas/report_common.schema.json#/$defs/versions"
    },
    "dtype_mutation": {
      "$ref": "#/$defs/dtype_mutation"
    },
    "float_precision_mutation": {
      "$ref": "#/$defs/float_precision_mutation"
    }
  },
  "oneOf": [
    {
      "required": [
        "dtype_mutation"
      ],
      "not": {
        "required": [
          "float_precision_mutation"
        ]
      },
      "properties": {
        "operation": {
          "const": "dtype"
        },
        "options": {
          "required": [
            "dtype",
            "range_mode",
            "sample_pixels_per_channel",
            "auto_max_normalized_rmse"
          ],
          "properties": {
            "operation": {
              "const": "dtype"
            }
          }
        }
      }
    },
    {
      "required": [
        "float_precision_mutation"
      ],
      "not": {
        "required": [
          "dtype_mutation"
        ]
      },
      "properties": {
        "operation": {
          "const": "float32_precision"
        },
        "options": {
          "properties": {
            "operation": {
              "const": "float32_precision"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "dtype"
                ]
              },
              {
                "required": [
                  "range_mode"
                ]
              },
              {
                "required": [
                  "sample_pixels_per_channel"
                ]
              },
              {
                "required": [
                  "auto_max_normalized_rmse"
                ]
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "dtype_mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "source_dtype",
        "target_dtype",
        "range_mode",
        "rounding",
        "clipping_policy",
        "automatic_range_policy",
        "channels"
      ],
      "properties": {
        "protocol_version": {
          "const": "1.0"
        },
        "source_dtype": {
          "enum": [
            "float32",
            "float64"
          ]
        },
        "target_dtype": {
          "enum": [
            "uint8",
            "uint16"
          ]
        },
        "range_mode": {
          "enum": [
            "auto",
            "preserve",
            "full"
          ]
        },
        "rounding": {
          "const": "nearest, ties to even"
        },
        "clipping_policy": {
          "const": "none for finite source values"
        },
        "automatic_range_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "near_integer_tolerance",
            "moderate_near_integer_fraction",
            "moderate_enrichment_over_uniform_fractional_parts",
            "strong_near_integer_fraction",
            "strong_enrichment_over_uniform_fractional_parts",
            "maximum_unit_rounding_normalized_rmse",
            "decision"
          ],
          "properties": {
            "near_integer_tolerance": {
              "type": "number",
              "minimum": 0
            },
            "moderate_near_integer_fraction": {
              "type": "number",
              "minimum": 0
            },
            "moderate_enrichment_over_uniform_fractional_parts": {
              "type": "number",
              "minimum": 0
            },
            "strong_near_integer_fraction": {
              "type": "number",
              "minimum": 0
            },
            "strong_enrichment_over_uniform_fractional_parts": {
              "type": "number",
              "minimum": 0
            },
            "maximum_unit_rounding_normalized_rmse": {
              "type": "number",
              "minimum": 0
            },
            "decision": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "channel_index",
              "channel_name",
              "source",
              "integer_lattice_evidence",
              "automatic_preserve_assessment",
              "mapping",
              "anticipated_loss"
            ],
            "properties": {
              "channel_index": {
                "type": "integer",
                "minimum": 0
              },
              "channel_name": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dtype",
                  "total_pixels",
                  "finite_pixels",
                  "nan_pixels",
                  "positive_infinity_pixels",
                  "negative_infinity_pixels",
                  "negative_pixels",
                  "zero_pixels",
                  "nonzero_pixels",
                  "sample_pixels",
                  "minimum",
                  "maximum",
                  "nearest_integer_minimum",
                  "nearest_integer_maximum",
                  "sample_stride",
                  "sample_percentiles",
                  "sample_nonzero_percentiles",
                  "smallest_unsigned_dtype_after_unit_rounding",
                  "sample_nonzero_p0_1_to_p99_9_smallest_unsigned_dtype_after_unit_rounding",
                  "integer_code_span_bits"
                ],
                "properties": {
                  "dtype": {
                    "enum": [
                      "float32",
                      "float64"
                    ]
                  },
                  "total_pixels": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "finite_pixels": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "nan_pixels": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "positive_infinity_pixels": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "negative_infinity_pixels": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "negative_pixels": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "zero_pixels": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "nonzero_pixels": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sample_pixels": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minimum": {
                    "type": "number"
                  },
                  "maximum": {
                    "type": "number"
                  },
                  "nearest_integer_minimum": {
                    "type": "number"
                  },
                  "nearest_integer_maximum": {
                    "type": "number"
                  },
                  "sample_stride": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "sample_percentiles": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "p0_1",
                      "p1",
                      "p50",
                      "p99",
                      "p99_9"
                    ],
                    "properties": {
                      "p0_1": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "p1": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "p50": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "p99": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "p99_9": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  },
                  "sample_nonzero_percentiles": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "p0_1",
                      "p1",
                      "p50",
                      "p99",
                      "p99_9"
                    ],
                    "properties": {
                      "p0_1": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "p1": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "p50": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "p99": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "p99_9": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  },
                  "smallest_unsigned_dtype_after_unit_rounding": {
                    "enum": [
                      null,
                      "uint8",
                      "uint16",
                      "uint32",
                      "uint64"
                    ]
                  },
                  "sample_nonzero_p0_1_to_p99_9_smallest_unsigned_dtype_after_unit_rounding": {
                    "enum": [
                      null,
                      "uint8",
                      "uint16",
                      "uint32",
                      "uint64"
                    ]
                  },
                  "integer_code_span_bits": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  }
                }
              },
