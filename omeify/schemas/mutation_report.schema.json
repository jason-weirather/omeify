                  "exact_output_code_span_from_source_bounds",
                  "exact_output_code_span_bits",
                  "target_code_span_fraction_used_by_source_bounds",
                  "reason"
                ],
                "properties": {
                  "name": {
                    "enum": [
                      "identity",
                      "zero_anchored_linear",
                      "full_range_linear"
                    ]
                  },
                  "formula": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rounding": {
                    "const": "nearest, ties to even"
                  },
                  "offset_source_units": {
                    "type": "number"
                  },
                  "source_lower": {
                    "type": "number"
                  },
                  "source_upper": {
                    "type": "number"
                  },
                  "quantum_source_units_per_output_code": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "target_dtype": {
                    "enum": [
                      "uint8",
                      "uint16"
                    ]
                  },
                  "target_code_minimum": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "target_code_maximum": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "exact_output_code_minimum_from_source_bounds": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "exact_output_code_maximum_from_source_bounds": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "exact_output_code_span_from_source_bounds": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "exact_output_code_span_bits": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "target_code_span_fraction_used_by_source_bounds": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
