                  "rounded_code_span",
                  "near_integer_tolerance",
                  "uniform_fraction_expectation",
                  "evidence_near_integer_fraction",
                  "evidence_near_integer_enrichment",
                  "full_resolution_near_integer_fraction",
                  "unit_rounding_mae",
                  "unit_rounding_rmse",
                  "unit_rounding_normalized_rmse_of_nonzero_p0_1_to_p99_9_span",
                  "unit_rounding_maximum_absolute_error",
                  "sample_nonzero_robust_lower_p0_1",
                  "sample_nonzero_robust_upper_p99_9",
                  "sample_nonzero_robust_span",
                  "fractional_phase_concentration",
                  "unit_rounding_sample_p99_absolute_error",
                  "classification_thresholds"
                ],
                "properties": {
                  "classification": {
                    "enum": [
                      "inconclusive",
                      "weak",
                      "moderate",
                      "strong"
                    ]
                  },
                  "interpretation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "classification_basis": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_sample_pixels": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "evidence_near_integer_pixels": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "full_resolution_nonzero_pixels": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "full_resolution_near_integer_pixels": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sample_pixels_before_background_exclusion": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "background_pixels_excluded_from_sample": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "rounded_code_span": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "near_integer_tolerance": {
                    "type": "number",
                    "minimum": 0
                  },
                  "uniform_fraction_expectation": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "evidence_near_integer_fraction": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "evidence_near_integer_enrichment": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "full_resolution_near_integer_fraction": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "unit_rounding_mae": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "unit_rounding_rmse": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "unit_rounding_normalized_rmse_of_nonzero_p0_1_to_p99_9_span": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "unit_rounding_maximum_absolute_error": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sample_nonzero_robust_lower_p0_1": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sample_nonzero_robust_upper_p99_9": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sample_nonzero_robust_span": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "fractional_phase_concentration": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "unit_rounding_sample_p99_absolute_error": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "classification_thresholds": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "moderate_near_integer_fraction",
                      "moderate_enrichment",
                      "strong_near_integer_fraction",
                      "strong_enrichment"
                    ],
                    "properties": {
                      "moderate_near_integer_fraction": {
                        "type": "number",
                        "minimum": 0
                      },
                      "moderate_enrichment": {
                        "type": "number",
                        "minimum": 0
                      },
                      "strong_near_integer_fraction": {
                        "type": "number",
                        "minimum": 0
                      },
                      "strong_enrichment": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  }
                }
              },
              "automatic_preserve_assessment": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "nearest_integer_range_fits_target",
                  "strong_integer_lattice_evidence",
                  "unit_rounding_normalized_rmse",
                  "maximum_normalized_rmse",
                  "unit_rounding_loss_within_limit",
                  "preserve_source_scale"
                ],
                "properties": {
                  "nearest_integer_range_fits_target": {
                    "type": "boolean"
                  },
                  "strong_integer_lattice_evidence": {
                    "type": "boolean"
                  },
                  "unit_rounding_normalized_rmse": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "maximum_normalized_rmse": {
                    "type": "number",
                    "minimum": 0
                  },
                  "unit_rounding_loss_within_limit": {
                    "type": "boolean"
                  },
                  "preserve_source_scale": {
                    "type": "boolean"
                  }
                }
              },
              "mapping": {
                "type": "object",
