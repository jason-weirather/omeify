                    "type": "number"
                  },
                  "sample_mean_absolute_error_source_units": {
                    "type": "number"
                  },
                  "sample_root_mean_square_error_source_units": {
                    "type": "number"
                  },
                  "sample_p99_absolute_error_source_units": {
                    "type": "number"
                  },
                  "sample_maximum_absolute_error_source_units": {
                    "type": "number"
                  },
