                  "sample_nonzero_mean_signed_error_source_units",
                  "sample_nonzero_mean_absolute_error_source_units",
                  "sample_nonzero_root_mean_square_error_source_units",
                  "sample_nonzero_p99_absolute_error_source_units",
                  "sample_changed_fraction",
                  "sample_exactly_represented_fraction",
                  "sample_target_minimum_code_fraction",
                  "sample_target_maximum_code_fraction",
                  "sample_nonzero_changed_fraction",
                  "sample_nonzero_exactly_represented_fraction",
                  "sample_output_code_minimum",
                  "sample_output_code_maximum",
                  "sample_output_code_span",
